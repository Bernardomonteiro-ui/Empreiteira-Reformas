# URL pública definitiva (usada em canonical, sitemap, Open Graph e schema)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Defina como "true" para esconder os selos "PLACEHOLDER" depois de preencher os dados reais
NEXT_PUBLIC_HIDE_PLACEHOLDERS=false

# Endpoint que recebe o formulário (POST JSON) — ex.: https://formspree.io/f/xxxx
NEXT_PUBLIC_FORM_ENDPOINT=
